{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesignSpec",
  "type": "object",
  "required": ["components", "apiChanges", "openApiFragment", "schemaChanges", "adrs", "impactAnalysis"],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "responsibility"],
        "properties": {
          "name": { "type": "string" },
          "responsibility": { "type": "string" }
        }
      }
    },
    "apiChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path", "description"],
        "properties": {
          "method": { "type": "string" },
          "path": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "openApiFragment": { "type": "string", "minLength": 1 },
    "schemaChanges": { "type": "boolean" },
    "migrations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "adrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "decision", "rationale"],
        "properties": {
          "title": { "type": "string" },
          "decision": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "impactAnalysis": {
      "type": "object",
      "required": ["impactedFiles"],
      "properties": {
        "impactedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "impactedApis": { "type": "array", "items": { "type": "string" } },
        "dataFlows": { "type": "array", "items": { "type": "string" } }
      }
    },
    "newDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["coordinates", "license"],
        "properties": {
          "coordinates": { "type": "string" },
          "license": { "type": "string" }
        }
      }
    }
  }
}
